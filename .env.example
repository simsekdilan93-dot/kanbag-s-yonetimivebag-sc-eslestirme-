# Kan Bağışı Yönetim Sistemi — ortam değişkenleri ÖRNEĞİ (değerler gizli değil / boş).
# Gerçek değerleri bu dosyaya değil, sunucunun ortam değişkenlerine ya da depoya girmeyen ".env" dosyasına yazın.
# ASP.NET Core "__" (iki alt çizgi) işaretini bölüm ayırıcısı olarak okur: Dagitim__TersVekil = Dagitim:TersVekil.
# Ayrıntılar: docs/Dagitim.md

# --- Çalışma ortamı ---
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://0.0.0.0:5284

# --- Veritabanı (SQLite dosyası kalıcı bir klasörde olmalı) ---
ConnectionStrings__KanBagis=Data Source=/var/lib/kanbagis/kanbagis.db

# --- Dağıtım ---
# Oturum/CSRF şifreleme anahtarlarının kalıcı klasörü (boşsa yeniden başlatmada oturumlar düşer)
Dagitim__AnahtarKlasoru=/var/lib/kanbagis/anahtarlar
# nginx / IIS / Cloudflare tüneli arkasındaysa true
Dagitim__TersVekil=true

# --- Harici servisler (isteğe bağlı; boş bırakılırsa ilgili özellik kendiliğinden kapalı) ---
DisServisler__Mesafe__Etkin=true
DisServisler__Ntfy__Etkin=true
DisServisler__Ntfy__Token=
DisServisler__Twilio__AccountSid=
DisServisler__Twilio__AuthToken=
DisServisler__Twilio__Gonderen=
DisServisler__YapayZeka__Etkin=true
ANTHROPIC_API_KEY=
