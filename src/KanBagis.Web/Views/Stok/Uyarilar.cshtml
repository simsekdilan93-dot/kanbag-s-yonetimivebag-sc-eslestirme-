@using KanBagis.Business.Stok
@model List<StokUyarisi>
@{
    ViewData["Title"] = "Stok uyarıları";
}

<h1 class="h3 mb-1">Stok uyarıları</h1>
<p class="text-muted">Kritik eşik uyarılarının geçmişi. Bir kan grubunun aynı anda en fazla bir açık uyarısı olur.</p>

<div class="table-responsive">
    <table class="table table-sm align-middle">
        <thead>
            <tr><th>Kan grubu</th><th>Seviye</th><th class="text-end">Stok / eşik</th><th>Açılış</th><th>Durum</th></tr>
        </thead>
        <tbody>
            @foreach (var u in Model)
            {
                <tr>
                    <td class="fw-semibold">@u.KanGrubu.Ad</td>
                    <td><span class="badge @Gorunum.StokDurumRozeti(u.Seviye)">@StokService.DurumAdi(u.Seviye)</span></td>
                    <td class="text-end">@u.StokDegeri / @u.Esik</td>
                    <td>@u.AcilisTarihi.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                    <td>
                        @if (u.KapanisTarihi is { } k)
                        {
                            <span class="text-success">Kapandı · @k.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</span>
                        }
                        else
                        {
                            <span class="badge text-bg-danger">Açık</span>
                        }
                    </td>
                </tr>
            }
            @if (Model.Count == 0) { <tr><td colspan="5" class="text-muted">Uyarı yok.</td></tr> }
        </tbody>
    </table>
</div>
<a asp-action="Index" class="btn btn-outline-secondary btn-sm">← Stok takibi</a>
