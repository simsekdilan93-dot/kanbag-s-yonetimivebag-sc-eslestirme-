@model BagisciProfilViewModel
@{
    ViewData["Title"] = "Profilim";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <h1 class="h3 mb-4">Profilim</h1>

        <div class="card mb-4">
            <div class="card-body">
                <h2 class="h6 text-uppercase text-muted">Kimlik bilgileri</h2>
                <dl class="row mb-0">
                    <dt class="col-sm-4">Ad soyad</dt>
                    <dd class="col-sm-8">@Model.AdSoyad</dd>
                    <dt class="col-sm-4">TC kimlik no</dt>
                    <dd class="col-sm-8">@Model.TcMaskeli</dd>
                    <dt class="col-sm-4">Doğum tarihi</dt>
                    <dd class="col-sm-8">@Model.DogumTarihi.ToString("dd.MM.yyyy")</dd>
                    <dt class="col-sm-4">Cinsiyet</dt>
                    <dd class="col-sm-8">@Model.Cinsiyet</dd>
                </dl>
                <p class="small text-muted mt-2 mb-0">Kimlik bilgileri bu sayfadan değiştirilemez.</p>
            </div>
        </div>

        <form asp-action="Profil" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label asp-for="Telefon" class="form-label"></label>
                    <input asp-for="Telefon" class="form-control" inputmode="tel" autocomplete="tel" />
                    <span asp-validation-for="Telefon" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Il" class="form-label"></label>
                    <select asp-for="Il" asp-items="@(new Microsoft.AspNetCore.Mvc.Rendering.SelectList(Iller.AlfabetikSirali))" class="form-select">
                        <option value="">Seçin</option>
                    </select>
                    <span asp-validation-for="Il" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Kilo" class="form-label"></label>
                    <input asp-for="Kilo" type="number" class="form-control" inputmode="numeric" />
                    <span asp-validation-for="Kilo" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="KanGrubuId" class="form-label"></label>
                    @if (Model.KanGrubuKilitli)
                    {
                        @* Kilitliyse seçim kutusu pasif; değer yine de gönderilsin diye gizli alan. Sunucu ayrıca kontrol eder. *@
                        <select asp-for="KanGrubuId" asp-items="Model.KanGruplari" class="form-select" disabled></select>
                        <input type="hidden" asp-for="KanGrubuId" />
                        <div class="form-text">Bağış kaydınız olduğu için kan grubunuz laboratuvarda doğrulanmıştır ve değiştirilemez.</div>
                    }
                    else
                    {
                        <select asp-for="KanGrubuId" asp-items="Model.KanGruplari" class="form-select"></select>
                        <div class="form-text">İlk bağışınızdan sonra kan grubunuz kilitlenir.</div>
                    }
                    <span asp-validation-for="KanGrubuId" class="text-danger"></span>
                </div>
            </div>

            <button type="submit" class="btn btn-danger">Kaydet</button>
            <a asp-action="Index" class="btn btn-link">Vazgeç</a>
        </form>

        <div class="card mt-5">
            <div class="card-body">
                <h2 class="h5">Telefon bildirimleri</h2>
                <p class="small text-muted">
                    Kan çağrıları her zaman bu sitedeki panelinde görünür. İstersen ayrıca telefonuna da gönderilir.
                    Telefona giden mesajda adın ya da telefonun yazmaz; yalnızca il, kan grubu ve ünite sayısı yazar.
                </p>

                <h3 class="h6 mt-3">Anlık bildirim (ntfy uygulaması)</h3>
                @if (!Model.AnlikServisAcik)
                {
                    <p class="small text-muted">Anlık bildirim servisi şu an kapalı.</p>
                }
                else if (Model.AnlikKanal is null)
                {
                    <form asp-action="AnlikBildirim" method="post">
                        <input type="hidden" name="ac" value="true" />
                        <button type="submit" class="btn btn-outline-danger btn-sm">Anlık bildirimi aç</button>
                    </form>
                }
                else
                {
                    <ol class="small mb-2">
                        <li>Telefonuna <strong>ntfy</strong> uygulamasını kur (Google Play / App Store, ücretsiz).</li>
                        <li>Uygulamada <strong>+</strong> → <strong>Subscribe to topic</strong> → şu kanal adını yaz: <code>@Model.AnlikKanal</code></li>
                    </ol>
                    <p class="small mb-2">Ya da telefonundan şu adresi aç: <a href="@Model.AnlikAbonelikAdresi" target="_blank" rel="noopener">@Model.AnlikAbonelikAdresi</a></p>
                    <p class="small text-muted mb-2">Kanal adı rastgeledir; adı bilmeyen kimse mesajlarını göremez. Kimseyle paylaşma.</p>
                    <form asp-action="AnlikBildirim" method="post">
                        <input type="hidden" name="ac" value="false" />
                        <button type="submit" class="btn btn-outline-secondary btn-sm">Anlık bildirimi kapat</button>
                    </form>
                }

                <h3 class="h6 mt-4">SMS</h3>
                @if (!Model.SmsServisAcik)
                {
                    <p class="small text-muted mb-2">SMS servisi şu an yapılandırılmamış. İzin verirsen servis açıldığında SMS de alırsın.</p>
                }
                <form asp-action="SmsIzni" method="post" class="d-flex align-items-center gap-2">
                    <input type="hidden" name="izin" value="@(Model.SmsIzni ? "false" : "true")" />
                    <span class="small">@(Model.SmsIzni ? "SMS ile bildirim almayı kabul ettin." : "SMS ile bildirim almıyorsun.")</span>
                    <button type="submit" class="btn btn-outline-secondary btn-sm">@(Model.SmsIzni ? "İzni geri al" : "SMS izni ver")</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
