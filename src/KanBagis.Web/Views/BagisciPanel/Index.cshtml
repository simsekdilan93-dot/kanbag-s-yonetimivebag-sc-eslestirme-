@model BagisciPaneli
@{
    ViewData["Title"] = "Bağışçı paneli";
    var profil = Model.Profil;
    var b = profil.Bagisci;
    var uygunluk = profil.Uygunluk;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <h1 class="h3 mb-0">Merhaba, @b.Ad</h1>
    <a asp-action="Profil" class="btn btn-outline-secondary btn-sm">Profilimi düzenle</a>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <div class="text-muted small">Kan grubu</div>
                <div class="fs-3 fw-semibold text-danger">@b.KanGrubu.Ad</div>
                <div class="small text-muted">@b.Sehir · @profil.BagisSayisi bağış</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <div class="text-muted small">Son bağış</div>
                <div class="fs-5">@(profil.SonBagisTarihi?.ToString("dd.MM.yyyy") ?? "Henüz bağış yok")</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 @(uygunluk.Uygun ? "border-success" : "border-warning")">
            <div class="card-body">
                <div class="text-muted small">Bağış durumu</div>
                @if (uygunluk.Uygun)
                {
                    <div class="fs-5 text-success">Bağış yapabilirsiniz</div>
                }
                else
                {
                    <div class="fs-5">Şu an bağış yapamazsınız</div>
                    <ul class="small mb-0 ps-3">
                        @foreach (var neden in uygunluk.Nedenler)
                        {
                            <li>@neden</li>
                        }
                    </ul>
                    @if (uygunluk.SonrakiUygunTarih is { } tarih)
                    {
                        <div class="small mt-1">Uygun olacağınız tarih: <strong>@tarih.ToString("dd.MM.yyyy")</strong></div>
                    }
                }
            </div>
        </div>
    </div>
</div>

<h2 class="h5">
    Kan çağrıları
    @if (Model.BekleyenSayisi > 0)
    {
        <span class="badge text-bg-danger align-middle">@Model.BekleyenSayisi yanıt bekliyor</span>
    }
</h2>
@if (Model.Bildirimler.Count == 0)
{
    <p class="text-muted">Henüz bildiriminiz yok. Kan grubunuza uygun bir talep açıldığında burada görünecek.</p>
}
else
{
    <div class="list-group">
        @foreach (var bildirim in Model.Bildirimler)
        {
            var talep = bildirim.KanTalebi;
            var yanitlanabilir = BagisciPaneli.YanitlanabilirMi(bildirim);
            <div class="list-group-item @(yanitlanabilir && talep.Aciliyet == Aciliyet.Acil ? "list-group-item-danger" : "")">
                <div class="d-flex flex-wrap justify-content-between gap-2">
                    <div>
                        <div class="fw-semibold">
                            @talep.Hastane.Ad (@talep.Hastane.Sehir) · @talep.KanGrubu.Ad
                            @if (talep.Aciliyet == Aciliyet.Acil)
                            {
                                <span class="badge text-bg-danger">ACİL</span>
                            }
                            @if (!bildirim.Okundu)
                            {
                                <span class="badge text-bg-primary">Yeni</span>
                            }
                        </div>
                        <div class="small">@bildirim.Mesaj</div>
                        <div class="small text-muted">
                            @bildirim.GonderimTarihi.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                            @if (talep.Durum != TalepDurumu.Acik)
                            {
                                <span> · talep @Gorunum.Durum(talep.Durum).ToLower()</span>
                            }
                        </div>
                    </div>
                    <div class="text-nowrap align-self-center">
                        @if (yanitlanabilir)
                        {
                            <form asp-action="Yanitla" method="post" class="d-inline">
                                <input type="hidden" name="bildirimId" value="@bildirim.Id" />
                                <button type="submit" name="yanit" value="@BildirimYaniti.Kabul" class="btn btn-success btn-sm" disabled="@(!uygunluk.Uygun)">Gelebilirim</button>
                                <button type="submit" name="yanit" value="@BildirimYaniti.Red" class="btn btn-outline-secondary btn-sm">Gelemem</button>
                            </form>
                        }
                        else
                        {
                            <span class="small @(bildirim.Yanit == BildirimYaniti.Kabul ? "text-success fw-semibold" : "text-muted")">@Gorunum.Yanit(bildirim.Yanit)</span>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
