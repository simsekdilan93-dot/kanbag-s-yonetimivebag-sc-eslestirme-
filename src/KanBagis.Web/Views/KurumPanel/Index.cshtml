@model KurumPaneli
@{
    ViewData["Title"] = "Kurum paneli";
}

<h1 class="h3 mb-1">@Model.Hastane.Ad</h1>
<p class="text-muted mb-4">@Model.Hastane.Sehir · @Model.Hastane.Telefon</p>

<div class="row g-4">
    <div class="col-lg-6">
        <h2 class="h5">Kan talepleriniz</h2>
        @if (Model.Talepler.Count == 0)
        {
            <p class="text-muted">Henüz kan talebi oluşturmadınız.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr><th>Tarih</th><th>Kan grubu</th><th>Ünite</th><th>Aciliyet</th><th>Durum</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var t in Model.Talepler)
                        {
                            <tr>
                                <td>@t.OlusturmaTarihi.ToString("dd.MM.yyyy")</td>
                                <td>@t.KanGrubu.Ad</td>
                                <td>@t.UniteSayisi</td>
                                <td>@(t.Aciliyet == Aciliyet.Acil ? "Acil" : "Normal")</td>
                                <td>@t.Durum</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <div class="col-lg-6">
        <h2 class="h5">Kan grubu durumu</h2>
        <div class="table-responsive">
            <table class="table table-sm align-middle">
                <thead>
                    <tr>
                        <th>Kan grubu</th>
                        <th class="text-end">Stok (ünite)</th>
                        <th class="text-end">@Model.Hastane.Sehir'de uygun bağışçı</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var g in Model.KanGruplari)
                    {
                        <tr class="@(g.StokUnite < 5 ? "table-warning" : "")">
                            <td>@g.KanGrubu.Ad</td>
                            <td class="text-end">@g.StokUnite</td>
                            <td class="text-end">@g.IldekiUygunBagisciSayisi</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <p class="small text-muted">
            Sarı satırlar: stok 5 ünitenin altında.
            "Uygun bağışçı": bu gruba <a asp-controller="KanGrubu" asp-action="Index">kan verebilecek</a> (yalnızca aynı grup değil)
            ve bugün bağış koşullarını (yaş, kilo, son bağış) sağlayan bağışçı sayısı.
            Kişisel bilgiler (KVKK) gösterilmez.
        </p>
    </div>
</div>
