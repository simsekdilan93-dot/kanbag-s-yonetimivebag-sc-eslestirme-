@model KurumPaneli
@{
    ViewData["Title"] = "Kurum paneli";
}

<h1 class="h3 mb-1">@Model.Hastane.Ad</h1>
<p class="text-muted mb-4">@Model.Hastane.Sehir · @Model.Hastane.Telefon</p>

<div class="row g-4">
    <div class="col-lg-6">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <h2 class="h5 mb-0">Kan talepleriniz</h2>
            <a asp-controller="KurumTalep" asp-action="Yeni" class="btn btn-danger btn-sm">+ Yeni talep</a>
        </div>
        @if (Model.Talepler.Count == 0)
        {
            <p class="text-muted">Henüz kan talebi oluşturmadınız.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr><th>#</th><th>Kan grubu</th><th>Kabul / ünite</th><th>Durum</th><th>Tarih</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var o in Model.Talepler)
                        {
                            var t = o.Talep;
                            <tr>
                                <td><a asp-controller="KurumTalep" asp-action="Detay" asp-route-id="@t.Id">#@t.Id</a></td>
                                <td>
                                    @t.KanGrubu.Ad
                                    @if (t.Aciliyet == Aciliyet.Acil)
                                    {
                                        <span class="badge text-bg-danger ms-1">ACİL</span>
                                    }
                                </td>
                                <td>@o.KabulSayisi / @t.UniteSayisi <span class="small text-muted">(@o.BildirimSayisi bildirim)</span></td>
                                <td><span class="badge @Gorunum.DurumRozeti(t.Durum)">@Gorunum.Durum(t.Durum)</span></td>
                                <td>@t.OlusturmaTarihi.ToLocalTime().ToString("dd.MM.yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <div class="col-lg-6">
        <h2 class="h5">Kan grubu durumu</h2>
        <div class="table-responsive">
            <table class="table table-sm align-middle">
                <thead>
                    <tr>
                        <th>Kan grubu</th>
                        <th class="text-end">Stok (ünite)</th>
                        <th class="text-end">@Model.Hastane.Sehir'de uygun bağışçı</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var g in Model.KanGruplari)
                    {
                        <tr class="@(g.StokUnite < 5 ? "table-warning" : "")">
                            <td>@g.KanGrubu.Ad</td>
                            <td class="text-end">@g.StokUnite</td>
                            <td class="text-end">@g.IldekiUygunBagisciSayisi</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <p class="small text-muted">
            Sarı satırlar: stok 5 ünitenin altında.
            "Uygun bağışçı": bu gruba <a asp-controller="KanGrubu" asp-action="Index">kan verebilecek</a> (yalnızca aynı grup değil)
            ve bugün bağış koşullarını (yaş, kilo, son bağış) sağlayan bağışçı sayısı.
            Kişisel bilgiler (KVKK) gösterilmez.
        </p>
    </div>
</div>
