@model ErrorViewModel
@{
    ViewData["Title"] = "Hata";
}

<div class="text-center py-5">
    <h1 class="display-6 text-danger">Bir hata oluştu</h1>
    <p class="text-muted">İsteğiniz işlenirken beklenmeyen bir sorun çıktı. Lütfen daha sonra tekrar deneyin.</p>
    @* Ayrıntılı hata bilgisi (yığın izi vb.) kullanıcıya gösterilmez; yalnızca destek için istek numarası verilir. *@
    @if (Model.ShowRequestId)
    {
        <p class="small text-muted">İstek numarası: <code>@Model.RequestId</code></p>
    }
    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Ana sayfaya dön</a>
</div>
