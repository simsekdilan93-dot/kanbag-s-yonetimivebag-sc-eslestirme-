@model BagisciKayitViewModel
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Bağışçı kaydı";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <h1 class="h3 mb-1">Bağışçı olarak kayıt ol</h1>
        <p class="text-muted mb-4">Kan grubunuza uygun bir ihtiyaç olduğunda size bildirim gönderilir.</p>

        <form asp-action="KayitBagisci" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <h2 class="h6 text-uppercase text-muted mt-2">Hesap bilgileri</h2>
            <div class="row g-3 mb-4">
                <div class="col-12">
                    <label asp-for="Eposta" class="form-label"></label>
                    <input asp-for="Eposta" class="form-control" autocomplete="email" />
                    <span asp-validation-for="Eposta" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Parola" class="form-label"></label>
                    <input asp-for="Parola" class="form-control" autocomplete="new-password" />
                    <div class="form-text">En az 8 karakter, en az bir harf ve bir rakam.</div>
                    <span asp-validation-for="Parola" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="ParolaTekrar" class="form-label"></label>
                    <input asp-for="ParolaTekrar" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="ParolaTekrar" class="text-danger"></span>
                </div>
            </div>

            <h2 class="h6 text-uppercase text-muted">Kişisel bilgiler</h2>
            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label asp-for="Ad" class="form-label"></label>
                    <input asp-for="Ad" class="form-control" autocomplete="given-name" />
                    <span asp-validation-for="Ad" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Soyad" class="form-label"></label>
                    <input asp-for="Soyad" class="form-control" autocomplete="family-name" />
                    <span asp-validation-for="Soyad" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="TcKimlikNo" class="form-label"></label>
                    <input asp-for="TcKimlikNo" class="form-control" inputmode="numeric" maxlength="11" />
                    <span asp-validation-for="TcKimlikNo" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Telefon" class="form-label"></label>
                    <input asp-for="Telefon" class="form-control" inputmode="tel" placeholder="05xxxxxxxxx" autocomplete="tel" />
                    <span asp-validation-for="Telefon" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="DogumTarihi" class="form-label"></label>
                    <input asp-for="DogumTarihi" type="date" class="form-control" max="@DateTime.Today.AddYears(-BagisciDogrulama.KayitIcinMinimumYas).ToString("yyyy-MM-dd")" />
                    <span asp-validation-for="DogumTarihi" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Cinsiyet" class="form-label"></label>
                    <select asp-for="Cinsiyet" asp-items="Html.GetEnumSelectList<Cinsiyet>()" class="form-select">
                        <option value="">Seçin</option>
                    </select>
                    <span asp-validation-for="Cinsiyet" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="KanGrubuId" class="form-label"></label>
                    <select asp-for="KanGrubuId" asp-items="Model.KanGruplari" class="form-select">
                        <option value="">Seçin</option>
                    </select>
                    <span asp-validation-for="KanGrubuId" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Il" class="form-label"></label>
                    <select asp-for="Il" asp-items="@(new SelectList(Iller.AlfabetikSirali))" class="form-select">
                        <option value="">Seçin</option>
                    </select>
                    <div class="form-text">Kan ihtiyacı olduğunda bu ildeki talepler için bildirim alırsınız.</div>
                    <span asp-validation-for="Il" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Kilo" class="form-label"></label>
                    <input asp-for="Kilo" type="number" class="form-control" inputmode="numeric" />
                    <div class="form-text">Bağış için en az @BagisUygunlukKurali.MinimumKilo kg gerekir.</div>
                    <span asp-validation-for="Kilo" class="text-danger"></span>
                </div>
            </div>

            <button type="submit" class="btn btn-danger">Kayıt ol</button>
            <a asp-action="Giris" class="btn btn-link">Zaten hesabım var</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
